# Public (safe to expose to the browser) -------------------------------------
# Supabase project URL. Local: the value printed by `supabase start`
# (see supabase/config.toml -- this project uses 54421, not the 54321 default).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
# Publishable key. RLS is what protects the data; this key is not a secret.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Canonical origin, used for OpenGraph URLs. Set this on Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Server-only. Never prefix these with NEXT_PUBLIC_. ----------------------
# Service-role key. Required for every write in the app: attendance edits,
# worker changes, task approval, dispute resolution and hazard triage all run
# through the service role so the business rules cannot be skipped by a caller
# holding a valid JWT. See docs/db/README.md.
SUPABASE_SERVICE_ROLE_KEY=

# HMAC-SHA256 secret for inbound gateway webhooks. Not used by any route that
# exists today; set it if the SMS/voice gateway is connected.
WEBHOOK_HMAC_SECRET=
# Bearer token guarding /api/jobs/*. Same: no route uses it yet.
JOB_SECRET=

# ---- App behaviour -----------------------------------------------------------
# true only on the demo deployment. Enables sites.demo_now and /api/demo/*.
DEMO_MODE=false
# simulator (default) or android_gateway.
SMS_ADAPTER=simulator
# android_gateway: basic auth credentials.
GATEWAY_USER=
GATEWAY_PASSWORD=
# Comma-separated E.164 numbers permitted to receive real SMS.
GATEWAY_ALLOWLIST=
# true disables every AI call and forces the deterministic fallbacks. With this
# on, task drafts come from the roster-matching parser in lib/domain/tasks.ts
# and the day summary carries no generated narrative.
AI_DISABLED=true
