# ---- Public (safe to expose to the browser) ----
# Supabase project URL. Local: the value printed by `supabase start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
# Publishable key. RLS is what protects data; this key is not a secret.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# ---- Server-only. Never prefix these with NEXT_PUBLIC_. ----
# Service-role key. Only for unauthenticated, signature-verified webhooks and
# JOB_SECRET cron endpoints, where there is no user session for RLS to scope.
# Leave empty locally unless a webhook or job actually needs it.
SUPABASE_SERVICE_ROLE_KEY=

# HMAC-SHA256 secret for inbound gateway webhooks (api.sms-gate.app).
WEBHOOK_HMAC_SECRET=
# Bearer token guarding /api/jobs/*.
JOB_SECRET=

# ---- App behaviour ----
# true only on the demo deployment. Enables sites.demo_now and /api/demo/*.
DEMO_MODE=false
# simulator (default) or android_gateway.
SMS_ADAPTER=simulator
# android_gateway: basic auth credentials.
GATEWAY_USER=
GATEWAY_PASSWORD=
# Comma-separated E.164 numbers permitted to receive real SMS.
GATEWAY_ALLOWLIST=
# true disables every AI call and forces the deterministic fallbacks.
AI_DISABLED=true
